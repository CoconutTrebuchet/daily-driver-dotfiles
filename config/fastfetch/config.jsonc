// logo source
// https://www.sekaipedia.org/wiki/Megurine_Luka
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
	"logo": {
		// "source": "NixOS2"
		"type": "sixel",
		"source": "$HOME/.config/fastfetch/1200px-Megurine_Luka-2720703339.png",
		"width": 20,
		"padding": {
			"left": 0,
			"right": 2
		}
	},
	"display": {
		"color": {
			"title": "magenta",
			"keys": "magenta"
		}
	},
  "modules": [
		"title",
		"separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
		"wm",
    "wmtheme",
    "theme",
    "terminal",
    "terminalfont",
		{
			"type": "cpu",
			"format": "{name} @ {freq-max}"
		},
    "gpu",
    "memory",
		"break",
    "colors"
  ]
}
