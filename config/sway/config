# Variables
#
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term alacritty
# fuzzel is launched this way to make QT apps honor the
# QT_GPA_PLATFORMTHEME=gtk3 environment variable
set $menu "sh -c 'fuzzel'"

# Wallpaper
#
output * bg $HOME/Pictures/wallpapers/anime-night.png fill
#exec wpaperd -d

# Outputs

# Example configuration:
# output HDMI-A-1 resolution 1920x1080 position 1920,0
# You can get the names of your outputs by running: swaymsg -t get_outputs
output eDP-1 position 0 0
output * scale 1
workspace 1 output eDP-1


# Swayidle
#
exec swayidle -w \
    timeout 300 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
    timeout 600 'swaylock -f' \
    before-sleep 'swaylock -f'

# Input configuration
#
    input * {
        middle_emulation false
    }

    input type:touchpad {
        dwt enabled
        tap enabled
        natural_scroll enabled
        accel_profile "flat"
        pointer_accel 0.65
    }

    input type:pointer {
        #scroll_factor 1.2
    }

    input type:keyboard {
        repeat_delay 450
        repeat_rate 35
    }

    input 2:10:TPPS/2_Elan_TrackPoint {
        accel_profile "flat"
        pointer_accel 0.05
    }
 
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.
# Colors and Aesthetic:
#
client.focused          #3a7099 #2a536f #e6e6e6 #3f7aa6 #3f7aa6
client.focused_inactive #4e4e4e #3c3c3c #e6e6e6 #272727 #272727
client.unfocused        #272727 #1f1f1f #e6e6e6 #272727 #272727
client.urgent           #a32929 #772222 #e6e6e6 #a32929 #a32929

default_border pixel 1
default_floating_border pixel 1
# gaps inner 4

# Waybar:
#
bar {
  swaybar_command waybar
}

# Miscellaneous:
# 
xwayland enable
focus_follows_mouse no
title_align center
exec swaync
exec autotiling
exec swayosd-server
font pango:"Adwaita Sans" 10
exec --no-startup-id /usr/bin/gnome-keyring-daemon --start

# These lines are useless (or cause problems) on NixOS
# so they are commented out
#
# seat seat0 xcursor_theme phinger-cursors-dark 24
# exec --no-startup-id /usr/lib/xdg-desktop-portal -r
# exec sh -c "$HOME/.config/swaync/swaync.sh"

# END
include /etc/sway/config.d/*
include ./config.d/*
